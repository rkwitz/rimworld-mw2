+static RELOAD_STARTED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// M24: the player with a [`Magazine`] started a reload.
+pub(crate) fn note_reload(client: u32) {
+    if magazine(client).is_some() {
+        RELOAD_STARTED.store(true, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// M24: whether the player with the [`Magazine`] started a reload since this was last asked.
+pub fn take_reload() -> bool {
+    RELOAD_STARTED.swap(false, std::sync::atomic::Ordering::Relaxed)
+}
