+    gun.mag.filter(|&mag| mag > 0).map_or(gun.burst, |mag| mag).clamp(1, 1000) as i32
+}
+
 /// Fires the player's gun as RimWorld fires their colonist's (M15): its clip holds one
 /// burst, its shots `between` apart, and once the burst is spent MW2 reloads, taking as long
 /// as RimWorld's cooldown and aiming time (M16), at the game's speed `rate`. Its reserve
-/// never runs out. `None` (no gun, or not playing) leaves MW2's own guns as they were.
+/// never runs out. Under Combat Extended (M24) the clip is the gun's magazine, never holding
+/// more than RimWorld has loaded: MW2 holds fire for the cooldown and aiming time after each
+/// burst, and reloads only once the clip is empty, taking as long as CE's reload and the
+/// aiming time. A gun with no CE ammo left, loaded or carried, has an empty clip and reserve.
+/// `None` (no gun, or not playing) leaves MW2's own guns as they were.
 fn fire_like_rimworld(floor: &mut FlatFloor, authority: &mut net::AuthorityWorld, local: sim::ClientId, gun: Option<rimworld_bridge::GunTiming>, rate: f32, dt: f32) {
     let Some(gun) = gun else {
         if floor.gun_clip.take().is_some() {
             sim::voxel::set_magazine(None);
         }
         floor.gun_hold = 0.0;
+        floor.gun_shots = 0;
         return;
     };
-    let rounds = gun.burst.clamp(1, 1000) as i32;
+    let fed = gun.mag.is_some_and(|mag| mag > 0);
+    let dry = gun.dry();
+    let rounds = match gun.loaded {
+        _ if dry => 0,
+        // RimWorld fills its magazine as soon as a shot empties it, so it is only seen empty
+        // when it can't be: then the whole magazine, not to cut MW2's reload short.
+        Some(loaded) if fed && loaded > 0 => clip_size(&gun).min(loaded as i32),
+        _ => clip_size(&gun),
+    };
+    let burst = gun.burst.clamp(1, 1000) as i32;
     floor.gun_hold = (floor.gun_hold - dt * rate.max(0.1)).max(0.0);
     let clip = authority.0.held_clip(local);
-    // A round fired: not the clip cut to a burst when the gun is handed over.
-    if let (Some(before), Some(now)) = (floor.gun_clip, clip)
-        && now < before
-        && before <= rounds
-    {
-        // The last of the burst: the reload that follows is RimWorld's wait.
-        floor.gun_hold = if now == 0 { 0.0 } else { gun.between };
+    if let (Some(before), Some(now)) = (floor.gun_clip, clip) {
+        // A round fired: not the clip cut to a burst when the gun is handed over, nor cut to
+        // what RimWorld has loaded.
+        if now < before && before <= rounds {
+            floor.gun_shots += 1;
+            floor.gun_hold = if now == 0 {
+                // The last of the clip: the reload that follows is RimWorld's wait.
+                0.0
+            } else if fed && floor.gun_shots >= burst {
+                gun.cooldown + gun.warmup
+            } else {
+                gun.between
+            };
+        }
+        if now == 0 || now > before || floor.gun_shots >= burst {
+            floor.gun_shots = 0;
+        }
     }
     floor.gun_clip = Some(clip.unwrap_or(0));
-    let reload = (gun.cooldown + gun.warmup) / rate.max(0.1);
+    let reload = match gun.reload {
+        Some(reload) if fed => reload + gun.warmup,
+        _ => gun.cooldown + gun.warmup,
+    } / rate.max(0.1);
     let reload_ms = (reload * 1000.0).round().clamp(100.0, 30_000.0) as i32;
-    sim::voxel::set_magazine(Some(sim::voxel::Magazine { client: local.0, rounds, hold: floor.gun_hold > 0.0, reload_ms }));
+    sim::voxel::set_magazine(Some(sim::voxel::Magazine { client: local.0, rounds, hold: floor.gun_hold > 0.0, reload_ms, fed, dry }));
 }
 
