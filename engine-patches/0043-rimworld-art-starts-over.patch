+    /// M25: RimWorld starts its pictures over when the atlas is nearly full. People keep
+    /// their pictures while the list grows, but not past a list that starts again, where
+    /// their numbers name other pictures.
+    #[test]
+    fn people_lose_their_pictures_when_rimworld_starts_its_art_over() {
+        let textures = |names: &[&str]| {
+            Some(Arc::new(Textures { dir: "nowhere".into(), names: names.iter().map(|s| s.to_string()).collect() }))
+        };
+        let link = |names: &[&str]| RimworldLink { textures: textures(names), ..Default::default() };
+        let mut floor = FlatFloor::default();
+        assert!(refresh_atlas(&mut floor, Some(&link(&["a_cut", "b_cut"]))));
+        let mut pawn = pawn("Human1", 10.5, 10.5);
+        pawn.art = Some([0, 1, 0]);
+        pawn.draw = Some([2.0, 2.0]);
+        follow_pawns(&mut floor.figures, std::slice::from_ref(&pawn), 100, 0.1);
+        assert!(refresh_atlas(&mut floor, Some(&link(&["a_cut", "b_cut", "c_cut"]))));
+        assert_eq!(floor.figures["Human1"].art, Some([0, 1, 0]), "a growing list keeps them");
+        assert!(refresh_atlas(&mut floor, Some(&link(&["c_cut"]))));
+        assert_eq!((floor.figures["Human1"].art, floor.figures["Human1"].was), (None, None), "a new list drops them");
+        pawn.art = Some([0, 0, 0]);
+        follow_pawns(&mut floor.figures, std::slice::from_ref(&pawn), 100, 0.1);
+        assert_eq!(floor.figures["Human1"].art, Some([0, 0, 0]), "until RimWorld sends them again");
+    }
