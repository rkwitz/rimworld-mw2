+    /// The sky and lamp light levels (Minecraft's, times 16) of faces looking into the cell
+    /// holding block point `(x, z)` below the roofs (M26). Open ground takes RimWorld's
+    /// daylight, which its sky sets for the whole floor at once, and its lamps' and fires'
+    /// light; roofed ground only the light already in its colour ([`Detail::light`]), so
+    /// night and an eclipse leave it as it is.
+    pub(crate) fn light_levels(&self, x: i32, z: i32) -> [u8; 2] {
+        if self.roof_at(x, z) != roof::NONE {
+            return ROOFED_LIGHT;
+        }
+        let lamp = match (&self.lit, self.index(x, z)) {
+            (Some(lit), Some(i)) => lit[i].min(15),
+            _ => 0,
+        };
+        [15 * 16, lamp * 16]
+    }
