+/// Lights each vertex by where it stands (M26): open ground by RimWorld's daylight and its
+/// lamps, roofed ground as before.
+fn light_by_place(vertices: &mut [Vertex], lay: Option<Lay>) {
+    let Some(lay) = lay else { return };
+    for vertex in vertices {
+        let [x, y, z] = vertex.position;
+        let [sky, lamp] = levels_in(lay, x.floor() as i32, z.floor() as i32, y.floor() as i32);
+        (vertex.sky_light, vertex.block_light) = (f32::from(sky) / 16.0, f32::from(lamp) / 16.0);
+    }
+}
