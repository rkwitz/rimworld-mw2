+/// The sky and lamp light levels at block point `(x, y, z)`, as [`light_in`] (M26): above the
+/// roofs, open sky.
+fn levels_in(lay: Lay, x: i32, z: i32, y: i32) -> [u8; 2] {
+    if y >= BUILT_HEIGHT {
+        return detail::OPEN_LIGHT;
+    }
+    lay.detail.map_or(detail::OPEN_LIGHT, |detail| detail.light_levels(x, z))
+}
