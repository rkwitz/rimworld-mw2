+fn celestial_bodies(sky: rimworld_bridge::Sky) -> (Vec3, Vec3, f32, f32, f32) {
+    let angle = (sky.day - 0.25) * std::f32::consts::TAU;
+    // A little to the south, as from north of the equator.
+    let sun = Vec3::new(angle.cos(), angle.sin(), 0.25).normalize();
+    let shown = if sky.sun > 0.01 { (sky.glow / sky.sun).clamp(0.0, 1.0) } else { 0.0 };
+    let moon_shown = ((0.3 - sky.sun) / 0.3).clamp(0.0, 1.0);
+    let dusk = 0.5 * (1.0 - sun.y.abs() / 0.3).clamp(0.0, 1.0) * shown;
+    (sun, -sun, shown, moon_shown, dusk)
